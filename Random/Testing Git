#include <stdio.h>
#include <stdlib.h>

int main(){
    printf("Hello!");
    printf("\nEnter a number! : ");
    int n;
    scanf("%d", &n);
    printf("The sum of numbers from 1 to %d is: %d", n, numCounter(n));
    return 0;
}

int numCounter(int n){
    if(n <= 0){
        return 0;
    }
    return n + numCounter(n-1);
}